# ---------------------------------------------------------------------------
# TakeYouUp LMS — docker compose environment
# Copy this file to `.env` and fill in the secrets before `docker compose up`.
# ---------------------------------------------------------------------------

# --- Host port mapping (change if these clash with other local services) ---
DB_HOST_PORT=3308
BACKEND_HOST_PORT=8082
FRONTEND_HOST_PORT=5174
ADMINER_HOST_PORT=8083

# --- Database ---
MYSQL_DATABASE=takeyouup
MYSQL_ROOT_PASSWORD=takeyouup

# --- Schema management ---
# validate = Flyway owns the schema, Hibernate only checks it (default/production).
# Set JPA_DDL_AUTO=update and SPRING_FLYWAY_ENABLED=false only for a one-off
# schema bootstrap against an empty database.
JPA_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# --- JWT ---
JWT_SECRET=takeyouupsecretkeytakeyouupsecretkeytakeyouupsecretkeytakeyouupsecretkey
JWT_EXPIRATION_MS=3600000

# --- Google Gemini (AI chatbot). Required for the /api/chatbot endpoint. ---
# Leave blank to fall back to the bundled demo key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- Mail (email verification, password reset, contact form) ---
# Leave these commented out to use the bundled Mailpit test inbox
# (http://localhost:8025) — every message the app sends lands there and no
# account is needed. Uncomment and fill in to send real email instead; SMTP
# auth and STARTTLS switch on automatically as soon as MAIL_USERNAME is set.
#
# Gmail example (use an App Password, not your account password):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=your-16-char-app-password
#
# Mailtrap example:
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=your-mailtrap-user
#   MAIL_PASSWORD=your-mailtrap-pass
MAIL_FROM=no-reply@takeyouup.local
MAILPIT_UI_PORT=8026

# --- Email verification ---
# false = users can sign in right away and see a "verify your email" banner.
# true  = unverified users are blocked at login.
REQUIRE_VERIFIED_EMAIL=false
