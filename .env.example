# ---------------------------------------------------------------------------
# TakeYouUp LMS — docker compose environment
# Copy this file to `.env` and fill in the secrets before `docker compose up`.
# ---------------------------------------------------------------------------

# --- Host port mapping (change if these clash with other local services) ---
DB_HOST_PORT=3308
BACKEND_HOST_PORT=8082
FRONTEND_HOST_PORT=5174
ADMINER_HOST_PORT=8083

# --- Database ---
MYSQL_DATABASE=takeyouup
MYSQL_ROOT_PASSWORD=takeyouup

# --- Schema management ---
# validate = Flyway owns the schema, Hibernate only checks it (default/production).
# Set JPA_DDL_AUTO=update and SPRING_FLYWAY_ENABLED=false only for a one-off
# schema bootstrap against an empty database.
JPA_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# --- JWT ---
JWT_SECRET=takeyouupsecretkeytakeyouupsecretkeytakeyouupsecretkeytakeyouupsecretkey
JWT_EXPIRATION_MS=3600000

# --- Google Gemini (AI chatbot). Required for the /api/chatbot endpoint. ---
# Leave blank to fall back to the bundled demo key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- Mail (contact form notifications). Optional. ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
